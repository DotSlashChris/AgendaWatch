# Secrets and local environment (never commit values)
.env
.env.*
!.env.example
cloudflare/.dev.vars
!.dev.vars.example
**/.dev.vars
!**/.dev.vars.example
internal_secret
**/.aw/
*.hdr
data/secret.key
SIGNIN_LINK.txt

# Customer data, SQLite, runtime state, logs
# Keep data/.gitkeep so a clean checkout has the directory (the app
# auto-creates data/secret.key but does not mkdir).
data/*
!data/.gitkeep
state/*
!state/.gitkeep
cache/
outbox/
backups/
*.db
*.sqlite
*.sqlite3
*.log

# Dated backups of earlier code
*.bak
*.bak-*
**/*.bak*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Wrangler
node_modules/
cloudflare/node_modules/
cloudflare/.wrangler/
cloudflare/dist/
dist/
build/
.cache/

# Local binaries and OS
cloudflared
.DS_Store
Thumbs.db

# Generated by db/apply.py verify
db/.work/
*.db-shm
*.db-wal
