# Local development only. Copy to .env and fill in TEST values.
# Never put live keys, and never commit .env.
# Production secrets are set with: wrangler secret put NAME
# (type or pipe the value on stdin; do not pass the value as a command-line argument).

# Stripe TEST MODE only for local runs (never sk_live_ / pk_live_ in .env).
# run_web.sh will refuse to start if live Stripe keys are present.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# From: stripe listen --forward-to localhost:8080/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Optional; created automatically if omitted
# STRIPE_PRICE_ID=price_REPLACE
# STRIPE_PORTAL_CONFIG_ID is legacy and ignored

AW_BASE_URL=http://localhost:8080

# Optional local SMTP (production uses Resend; leave unset for outbox-only)
# AW_SMTP_HOST=
# AW_SMTP_PORT=
# AW_SMTP_USER=
# AW_SMTP_PASS=
# AW_SMTP_FROM=

# Local identity (required for admin/owner features; production uses wrangler secrets).
# If AW_ADMIN_EMAILS is unset or empty, no one has admin access (fail closed).
AW_OWNER_EMAIL=owner@example.com
AW_ADMIN_EMAILS=admin@agendawatch.app
# NOTIFY_TO=inbox@example.invalid

# Production-only secret NAMES (do not put values here):
#   AW_INTERNAL_SECRET
#   RESEND_API_KEY
#   TURNSTILE_SECRET
#   STRIPE_SECRET_KEY          (live: sk_live_ or rk_live_)
#   STRIPE_PUBLISHABLE_KEY     (live: pk_live_)
#   STRIPE_WEBHOOK_SECRET      (live: whsec_)
#   AW_OWNER_EMAIL
#   AW_ADMIN_EMAILS            (comma-separated admin accounts)
#   NOTIFY_TO                  (verified Email Routing destination)
